# Windows 11 Intel AI PC Configuration Example
# Copy this to config.cfg and customize for your deployment
# File: docker/config.cfg

# ============================================================================
# HuggingFace Configuration (REQUIRED)
# ============================================================================
# Get your token from: https://huggingface.co/settings/tokens
hugging_face_token=hf_YOUR_TOKEN_HERE

# ============================================================================
# Model Selection
# ============================================================================
# Choose model(s) based on available RAM and use case
# Format: Comma-separated HuggingFace model IDs (no spaces after commas)

# Option 1: Lightweight (20-25 GB RAM) - Fast inference, testing
#models=meta-llama/Llama-3.2-3B-Instruct

# Option 2: Balanced (40-45 GB RAM) - General purpose
#models=meta-llama/Llama-3.1-8B-Instruct

# Option 3: Code-optimized (55-65 GB RAM) - Best for development (RECOMMENDED)
models=Qwen/Qwen2.5-Coder-14B-Instruct

# Option 4: Large model (80-90 GB RAM) - Requires 128 GB total RAM
#models=google/gemma-4-26B-A4B-it

# Option 5: Multiple models (100+ GB RAM) - Sequential ports 2080, 2081, 2082...
#models=Qwen/Qwen2.5-Coder-14B-Instruct,meta-llama/Llama-3.1-8B-Instruct

# ============================================================================
# Tool Call Parser (Optional)
# ============================================================================
# Enable function calling / tool use for models
# Set to 'none' to disable
# Common parsers: qwen3_coder, qwen3_xml, llama3_json, gemma4
# See model-configs.yaml for full list per model
tool_call_parser=none

# ============================================================================
# Deployment Options
# ============================================================================
# Docker installation (Windows: always use 'off')
deploy_docker_fresh=off

# Flowise: Visual agent builder with drag-and-drop interface
# Enables: http://localhost:3000
# Impact: +4 GB RAM, +2 CPU cores
deploy_agenticai_plugin=off

# Langfuse: LLM observability and tracing
# Enables: http://localhost:3002 (web UI)
# Impact: +6 GB RAM, +4 CPU cores (includes ClickHouse, MinIO)
# Note: Host/container metrics unavailable on Windows (no node-exporter/cadvisor)
deploy_observability=off

# ============================================================================
# Proxy Configuration (Optional)
# ============================================================================
# Corporate proxy settings for model downloads and external API calls
# Leave empty if not behind a proxy
http_proxy=
https_proxy=
no_proxy=localhost,127.0.0.1,.local

# ============================================================================
# Windows-Specific Notes
# ============================================================================
# 1. RAM Allocation:
#    Set in Docker Desktop → Settings → Resources
#    Recommended: 64 GB minimum (80+ GB for comfort)
#
# 2. CPU Allocation:
#    Set in Docker Desktop → Settings → Resources
#    Recommended: 16 cores minimum (24+ for large models)
#
# 3. WSL2 Configuration:
#    Edit %USERPROFILE%\.wslconfig to set WSL2 limits
#    See windows-setup.ps1 for automatic configuration
#
# 4. Performance:
#    Expect 10-20% slower than native Linux (acceptable for PoC)
#
# 5. First Deployment:
#    Model download takes 5-10 minutes for 14B model (~28 GB)
#    Be patient during initial vLLM startup
#
# 6. Subsequent Deployments:
#    Cached models load in 2-3 minutes
#
# ============================================================================
# Recommended Configurations by Use Case
# ============================================================================

# Minimal Testing (20-30 GB RAM total):
# models=meta-llama/Llama-3.2-3B-Instruct
# deploy_agenticai_plugin=off
# deploy_observability=off

# Development (50-70 GB RAM total):
# models=Qwen/Qwen2.5-Coder-14B-Instruct
# deploy_agenticai_plugin=on
# deploy_observability=off

# Full Stack Demo (60-80 GB RAM total):
# models=Qwen/Qwen2.5-Coder-14B-Instruct
# deploy_agenticai_plugin=on
# deploy_observability=on

# Multi-Model (100+ GB RAM total):
# models=Qwen/Qwen2.5-Coder-14B-Instruct,meta-llama/Llama-3.1-8B-Instruct
# deploy_agenticai_plugin=on
# deploy_observability=on

# ============================================================================
# Deployment Commands (Run in WSL2 Ubuntu terminal)
# ============================================================================
# Copy this example:
#   cp config.windows.example config.cfg
#   nano config.cfg  # Edit your token and preferences
#
# Deploy:
#   cd /home/<user>/applications.ai.enterprise.agentic-ai-stack
#   ./windows-deploy.sh start
#
# Check status:
#   ./windows-deploy.sh status
#
# View logs:
#   ./windows-deploy.sh logs
#
# Test API:
#   ./windows-deploy.sh test
#
# Access from Windows:
#   http://localhost:4000/ui  (LiteLLM Gateway)
#   http://localhost:2080/docs  (vLLM API)
#   http://localhost:3000  (Flowise, if enabled)
#   http://localhost:3002  (Langfuse, if enabled)
